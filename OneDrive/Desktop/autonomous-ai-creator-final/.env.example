# Copy to .env and adjust as needed. All values are optional — the app
# runs fully deterministically with local demo/fallback data if unset.

# Seconds between autonomous editorial cycles.
CYCLE_INTERVAL_SECONDS=10

# Max discovered candidates evaluated per cycle.
MAX_CANDIDATES_PER_CYCLE=12

# Jaccard title-similarity threshold (0-1) above which a topic is treated
# as a duplicate of a previously seen one.
DUPLICATE_SIMILARITY_THRESHOLD=0.80

# Optional. Not required — if unset, content generation uses the
# deterministic local writer fallback so the demo always works.
ANTHROPIC_API_KEY=

# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
