# Complete Glass Innovations — Server Environment Template
# Copy this file to server/.env and fill in your real credentials.

# ── Server Configuration ────────────────────────────────
PORT=3001
NODE_ENV=production

# ── Admin Panel Authentication & Session ────────────────
ADMIN_USER=admin
ADMIN_PASS=CHANGE_ME
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_STRING

# ── Email (SMTP Notifications) ──────────────────────────
# Set your SMTP credentials for owner quote enquiry alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password
SMTP_FROM=no-reply@completeglassinnovations.com.au
OWNER_EMAIL=Glen@completeglassinnovations.com.au

# ── SMS Notifications (Optional Twilio) ─────────────────
# Leave blank if not using SMS alerts
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
OWNER_PHONE=

# ── Reviews & Google Business Profile ───────────────────
GOOGLE_REVIEW_URL=https://search.google.com/local/writereview?placeid=ChIJCompleteGlassInnovations

# ── CORS ────────────────────────────────────────────────
ALLOWED_ORIGINS=https://completeglassinnovations.com.au,http://localhost:3000,http://localhost:3001

