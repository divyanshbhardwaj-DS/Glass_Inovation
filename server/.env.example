# Complete Glass Innovations — Server Environment

# ── Email (SMTP) ────────────────────────────────────────
# Credentials for the email account used to SEND enquiry notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-gmail-app-password

# The business email address where new enquiries are forwarded
NOTIFY_TO=info@completeglassinnovations.com.au

# ── SMS (Twilio) ─────────────────────────────────────────
# Uses the Twilio REST API directly (no SDK required).
# Leave any of these blank to skip SMS notifications entirely — the
# server always saves the enquiry to the DB regardless.
# Find these in your Twilio Console: https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=      # Your Twilio number, e.g. +61491570156
NOTIFY_SMS_TO=           # Mobile number that should receive lead alerts, e.g. +614xxxxxxxx

# ── Server ──────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ── Admin panel ─────────────────────────────────────────
# Simple HTTP Basic auth for /admin route
ADMIN_USER=admin
ADMIN_PASS=changeme123

# ── CORS ────────────────────────────────────────────────
# Comma-separated list of allowed origins (your production domain)
ALLOWED_ORIGINS=https://completeglassinnovations.com.au,http://localhost:3000,http://localhost:3001
